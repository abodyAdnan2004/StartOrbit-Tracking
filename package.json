{
  "name": "orbit-tracking",
  "version": "1.0.0",
  "description": "Orbit Tracking - Real-time location tracking system with dashboard, backend API, and mobile app",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter ./backend run dev & pnpm --filter ./frontend run dev",
    "dev:backend": "pnpm --filter ./backend run dev",
    "dev:frontend": "pnpm --filter ./frontend run dev",
    "dev:mobile": "pnpm --filter ./mobile run start",
    "install:all": "pnpm install",
    "build": "pnpm --filter ./backend run build && pnpm --filter ./frontend run build && pnpm --filter ./mobile run build:android",
    "build:backend": "pnpm --filter ./backend run build",
    "build:frontend": "pnpm --filter ./frontend run build",
    "build:mobile": "pnpm --filter ./mobile run build:android",
    "prisma:generate": "pnpm --filter ./backend run prisma:generate",
    "prisma:migrate": "pnpm --filter ./backend run prisma:migrate",
    "prisma:studio": "pnpm --filter ./backend run prisma:studio",
    "prisma:seed": "pnpm --filter ./backend run prisma:seed",
    "docker:up": "docker-compose -f backend/docker-compose.yml up -d",
    "docker:down": "docker-compose -f backend/docker-compose.yml down",
    "docker:logs": "docker-compose -f backend/docker-compose.yml logs -f",
    "docker:dev": "docker-compose -f backend/docker-compose.dev.yml up -d",
    "lint": "pnpm --filter ./frontend run lint && pnpm --filter ./backend run lint",
    "format": "pnpm --filter ./frontend run format && pnpm --filter ./backend run format"
  },
  "keywords": [
    "tracking",
    "realtime",
    "location",
    "dashboard",
    "mobile",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.4.0"
}