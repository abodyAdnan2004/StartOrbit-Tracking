# ===========================================
# Orbit Tracking Backend - Environment Variables
# Copy this file to .env and fill in your values
# ===========================================

# ===========================================
# DATABASE
# ===========================================
# Development: SQLite (file-based, no setup required)
# DATABASE_URL="file:./dev.db"

# Production: PostgreSQL
# DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# For Docker Compose:
# DATABASE_URL="postgresql://orbit_user:secure_password@postgres:5432/orbit_tracking?schema=public"

# ===========================================
# SERVER
# ===========================================
PORT=3000
NODE_ENV=development

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Generate secure secrets with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# ===========================================
# CORS & FRONTEND
# ===========================================
# Frontend URL for CORS and Socket.io
FRONTEND_URL="http://localhost:3029"
SOCKET_CORS_ORIGIN="http://localhost:3029"

# ===========================================
# POSTGRESQL (Production)
# ===========================================
# POSTGRES_PASSWORD=secure_password_change_me

# ===========================================
# OPTIONAL: EXTERNAL SERVICES
# ===========================================
# SENTRY_DSN=""
# LOG_LEVEL="info"