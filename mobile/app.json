{
  "expo": {
    "name": "Orbit Tracking",
    "slug": "orbit-tracking-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#3B82F6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.orbittracking.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Orbit Tracking needs access to your location to track your position in real-time.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Orbit Tracking needs access to your location even when the app is in the background to continue tracking your position.",
        "NSLocationAlwaysUsageDescription": "Orbit Tracking needs access to your location even when the app is in the background to continue tracking your position.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3B82F6"
      },
      "package": "com.orbittracking.mobile",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "INTERNET",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Orbit Tracking to access your location for real-time tracking.",
          "locationAlwaysPermission": "Allow Orbit Tracking to access your location even when the app is in background.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3B82F6",
          "sounds": ["./assets/notification.wav"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:3000/api"
    }
  }
}